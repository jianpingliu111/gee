<?xml version="1.0"?>
<package format="3">
  <name>swarm_heartbeat_monitor</name>
  <version>0.1.0</version>
  <description>Monitor MAVROS state heartbeats and publish a swarm failsafe trigger on timeout.</description>
  <maintainer email="maintainers@example.com">Swarm Heartbeat Monitor Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
